# Credentials and endpoints for fetch_api_data.py / update_and_push.sh
# Copy to .env (which is git-ignored) and fill in the secret values.
#
# Get credentials by registering at https://api.montevideo.gub.uy/

# --- Secrets (do NOT commit real values) ---
API_CLIENT_ID=your_client_id
API_CLIENT_SECRET=your_client_secret

# --- Endpoints (public; defaults already correct) ---
API_AUTH_URL=https://mvdapi-auth.montevideo.gub.uy/auth/realms/pci/protocol/openid-connect/token
API_ROUTES_URL=https://api.montevideo.gub.uy/api/transportepublico/buses/gtfs/static/latest/google_transit.zip
API_STOPS_URL=https://api.montevideo.gub.uy/api/transportepublico/buses/busstops
