{
    "name": "montevideo-bus-map",
    "private": true,
    "type": "module",
    "description": "Dev tooling for the Montevideo bus map (the app itself is a buildless static site)",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:update": "playwright test --update-snapshots",
        "verify:routes": "vitest run tests/js/route-invariants.test.js",
        "verify:colors": "vitest run tests/js/line-colors.test.js",
        "verify:scales": "node scripts/derive_geometry_scales.mjs",
        "assign:colors": "node scripts/assign_line_colors.mjs",
        "lint": "eslint src tests/js tests/e2e scripts",
        "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\" \"*.config.js\"",
        "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"css/**/*.css\" \"*.config.js\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.1",
        "eslint": "^10.6.0",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.4",
        "vitest": "^4.1.9"
    }
}
